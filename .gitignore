# 密钥：绝不入库（里面有 4 个 API key）
.env

# Python 缓存与构建产物
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 运行时数据：会话 checkpoint（10MB+ sqlite 及 WAL）与会话元数据。
# 这是本机状态，不是源码；每次聊天都会变，入库只会污染 diff。
data/

# 备份产物（scripts/backup.py 生成）。里面是完整的数据快照，
# 体积与 data/ 同级，绝不能入库。
backups/

# Agent 工作目录：本地记忆与临时探针。
# 测试脚本已迁到 tests/（入库），tmp/ 只是临时区，随手会被清空。
.workbuddy/

# 教材原件：26 个 PDF 共 461M，属于输入数据不是源码。
# 曾经因为没忽略，反复 git add 大 PDF 中断，在 .git/objects 里留下 36G 临时对象。
textbook/

# 解析产物：随时能从 textbook/ 重新生成，和 data/ 同理。
out/

# bench 基准输出：每次跑都生成新报告，历史结果留在本机即可。
tests/bench/runs/

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db

# 虚拟环境
.venv/
venv/
env/
