# DeepSeek API Key
DEEPSEEK_API_KEY=your-deepseek-api-key

# 高德地图 API Key（天气查询、逆地理编码）
AMAP_API_KEY=your-amap-api-key

# Tavily API Key（网页搜索、正文提取）
TAVILY_API_KEY=your-tavily-api-key

# 智谱 GLM API Key（MODEL_PROVIDER=glm 时使用）
GLM_API_KEY=your-glm-api-key

# 模型服务商：deepseek 或 glm
MODEL_PROVIDER=deepseek

# 硅基流动 API Key（视觉模型、向量、rerank）
SILICON_API_KEY=your-siliconflow-api-key

# 教材检索的向量服务（可选，未配置时退回 SILICON_API_KEY）
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_KEY=your-embedding-api-key
# 重排默认关闭。开它会多一次外部调用（中位 517ms → 1509ms），
# 只提升 recall@1，recall@5 与拒答率不变——除非要压缩上下文到 2~3 段，否则别开。
# RERANK_ENABLED=1

# MinerU 云端解析 API Key（按页计费）
MINERU_API_KEY=your-mineru-api-key

# MinerU 模型：vlm（公式/代码更准）
MINERU_MODEL=vlm
